# Store listing for `bundle exec fastlane store_listing`: metadata/ and screenshots/.
# Submitting for review is a separate lane (`submit_review`); nothing here does it.
app_identifier("be.appmire.secureqr")
platform("ios")
metadata_path("./fastlane/metadata")
screenshots_path("./fastlane/screenshots")
skip_binary_upload(true)
submit_for_review(false)
automatic_release(false)
overwrite_screenshots(true)
force(true)
precheck_include_in_app_purchases(false)
