# Managed by Ansible (secureqr). Do not edit on the box.
#
# The preview server opens links chosen by strangers in a headless Chromium.
# It listens on loopback only; nginx terminates TLS and reverse-proxies.
services:
  secureqr:
    build:
      context: ./src
      args:
        # one line in .env, raised by secureqr-update.sh
        PLAYWRIGHT_VERSION: ${PLAYWRIGHT_VERSION}
    image: secureqr-server
    container_name: secureqr
    init: true
    restart: unless-stopped
    networks: [egress]
    ports:
      - "127.0.0.1:{{ secureqr_port }}:8080"
    env_file: ./api.env
    environment:
      TRUST_PROXY: "1"
      RATE_LIMIT_PER_MIN: "{{ secureqr_rate_limit_per_min }}"
      MAX_CONCURRENCY: "{{ secureqr_max_concurrency }}"
      WARM_PAGES: "{{ secureqr_warm_pages }}"
      CACHE_DIR: /var/cache/secureqr
      RESULT_TTL_SEC: "{{ secureqr_result_ttl_sec }}"
      CACHE_MAX_MB: "{{ secureqr_cache_max_mb }}"
    # Chromium runs as a non-root user inside its own sandbox, which needs user
    # namespaces: the seccomp profile is Docker's default plus those calls, and
    # the AppArmor profile is Docker's default plus `userns`.
    # No cap_drop: dropping the bounding set breaks the browser sandbox, and a
    # non-root process with no-new-privileges holds no capabilities anyway.
    security_opt:
      - seccomp=./src/seccomp_profile.json
      - apparmor={{ secureqr_apparmor_profile }}
      - no-new-privileges:true
    read_only: true
    # Kept answers (encrypted, see server/README.md "Result reuse"); the only writable disk.
    volumes:
      - cache:/var/cache/secureqr
    tmpfs:
      - /tmp:exec,size=512m
      - /home/pwuser:exec,size=256m,uid=1001,gid=1001
    shm_size: 1gb
    mem_limit: {{ secureqr_mem_limit }}
    pids_limit: 1024
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }

volumes:
  cache:

# Its own bridge with a fixed name and range, so the host firewall
# (secureqr-firewall.sh) can pin it to the public internet.
networks:
  egress:
    name: secureqr_egress
    enable_ipv6: false
    driver_opts:
      com.docker.network.bridge.name: {{ secureqr_bridge }}
    ipam:
      config:
        - subnet: {{ secureqr_subnet }}
          gateway: {{ secureqr_gateway }}
