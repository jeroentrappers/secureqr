# Copy to `keystore.properties` (gitignored) and fill in the real values.
#
# Generate the upload keystore once:
#   keytool -genkeypair -v -keystore ~/.android/secureqr-release.jks \
#     -keyalg RSA -keysize 2048 -validity 36500 -alias secureqr
#
# Then point this file at it.
storeFile=/home/you/.android/secureqr-release.jks
storePassword=your-keystore-password
keyAlias=secureqr
keyPassword=your-key-password
