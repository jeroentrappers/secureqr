    <!-- Camera permission -->
    <string name="permission_title">SecureQR-க்கு உங்கள் கேமரா தேவை</string>
    <string name="permission_rationale">QR குறியீடுகளைப் படிக்க மட்டுமே கேமரா பயன்படுத்தப்படுகிறது. எதுவும் பதிவு செய்யப்படுவதில்லை, படங்கள் உங்கள் ஃபோனை விட்டு வெளியே செல்வதில்லை.</string>
    <string name="permission_allow">கேமராவை அனுமதி</string>
    <string name="permission_denied_title">கேமரா அணைக்கப்பட்டுள்ளது</string>
    <string name="permission_denied_body">கேமரா இல்லாமல் SecureQR ஸ்கேன் செய்ய முடியாது. அமைப்புகளில் அதை இயக்கலாம், அல்லது அதற்குப் பதிலாகக் கேலரியில் உள்ள படத்தை ஸ்கேன் செய்யலாம்.</string>
    <string name="permission_open_settings">அமைப்புகளைத் திற</string>
    <string name="permission_pick_image">படத்தை ஸ்கேன் செய்</string>

