    <!-- Typed cards: notices -->
    <string name="notice_payment">இது ஒரு பணக் கோரிக்கை. பணம் செலுத்தும் முன் பெயர், கணக்கு, தொகை ஆகியவற்றைச் சரிபாருங்கள். செலுத்திய பணத்தைத் திரும்பப் பெறுவது கடினம்.</string>
    <string name="notice_paylink">இது ஒரு பணக் கோரிக்கை. உறுதிசெய்யும் முன் உங்கள் கட்டண ஆப்பில் பெயரையும் தொகையையும் சரிபாருங்கள். செலுத்திய பணத்தைத் திரும்பப் பெறுவது கடினம்.</string>
    <string name="notice_epc_instruction">பணம் செலுத்த, உங்கள் வங்கி ஆப்பைத் திறந்து அதில் இந்த QR குறியீட்டை ஸ்கேன் செய்யுங்கள்.</string>
    <string name="notice_crypto">கிரிப்டோ கட்டணங்களைத் திரும்பப் பெற முடியாது.</string>
    <string name="notice_invalid_iban">இந்தக் கணக்கு எண் சரியான IBAN அல்ல.</string>
    <string name="notice_otp">இது ஓர் உள்நுழைவு ரகசியம். உங்கள் சொந்த அங்கீகரிப்பு ஆப்பில் மட்டுமே ஸ்கேன் செய்யுங்கள், யாருடனும் பகிர வேண்டாம்.</string>
    <string name="notice_wifi_open">இந்த நெட்வொர்க்குக்குக் கடவுச்சொல் இல்லை. அருகில் உள்ள எவரும் உங்கள் இணையப் போக்குவரத்தைப் பார்க்க முடியும்.</string>
    <string name="notice_sms_short_code">குறுகிய எண்களுக்கு அனுப்பும் செய்திகளுக்குக் கட்டணம் வசூலிக்கப்படலாம்.</string>
    <string name="notice_app_link">இது வேறொரு ஆப்பைத் திறக்கும். நீங்கள் இதை எதிர்பார்த்திருந்தால் மட்டும் தொடருங்கள்.</string>
    <string name="notice_login_code">இந்தக் குறியீடு வேறொரு சாதனத்தை உங்கள் கணக்கில் உள்நுழைய வைக்கும். அந்த ஆப்பின் உள்ளே, நீங்களே திறந்த திரையில் மட்டுமே இதை ஸ்கேன் செய்யுங்கள். யாராவது இதை உங்களுக்கு அனுப்பியிருந்தால், அது ஒரு மோசடி.</string>
    <string name="notice_chat_link">இது உங்களுக்குத் தெரியாத ஒருவருடன் அரட்டையைத் தொடங்கக்கூடும். நீங்கள் நம்பும் தளத்திலிருந்து உரையாடலை வெளியே நகர்த்த மோசடிக்காரர்கள் அரட்டை இணைப்புகளைப் பயன்படுத்துகின்றனர்.</string>
    <string name="notice_otp_export">அங்கீகரிப்பு ஆப்பில் உள்ள எல்லாக் கணக்குகளின் ரகசியங்களும் இந்தக் குறியீட்டில் உள்ளன. இதை ஸ்கேன் செய்யும் எவரும் உங்கள் உள்நுழைவுக் குறியீடுகளை உருவாக்க முடியும். உங்கள் சொந்தப் புதிய ஃபோனில் மட்டுமே ஸ்கேன் செய்யுங்கள், யாருடனும் பகிர வேண்டாம்.</string>
    <string name="notice_esim_instruction">இதை நிறுவ, உங்கள் ஃபோனின் மொபைல் நெட்வொர்க் அமைப்புகளைத் திறந்து eSIM-ஐச் சேருங்கள்.</string>
    <string name="notice_esim">இது உங்கள் ஃபோனில் ஒரு மொபைல் திட்டத்தை (eSIM) நிறுவும். இது உங்கள் சொந்த மொபைல் நிறுவனத்திடமிருந்து வந்திருந்தால் மட்டும் தொடருங்கள்.</string>
    <string name="notice_device_setup">இது ஒரு ஸ்மார்ட்-ஹோம் சாதனத்தின் அமைவுக் குறியீடு. இதை ஸ்கேன் செய்யும் எவரும் அந்தச் சாதனத்தைத் தங்கள் வீட்டில் சேர்க்க முடியும். உங்களுக்குச் சொந்தமான சாதனத்துக்கு, உங்கள் ஸ்மார்ட்-ஹோம் ஆப்பில் மட்டுமே ஸ்கேன் செய்யுங்கள்.</string>
    <string name="notice_health_cert">இது ஒரு சுகாதாரச் சான்றிதழ். இதில் ஒரு பெயர், பிறந்த தேதி, மருத்துவ விவரங்கள் உள்ளன. இது உங்கள் ஃபோனிலேயே படிக்கப்பட்டது, எங்கும் அனுப்பப்படவில்லை. இதைப் பகிர வேண்டாம்.</string>
    <string name="notice_unsafe_link">இது இணைய முகவரி அல்ல. இந்த வகை இணைப்புகள் உங்கள் ஃபோனில் குறியீட்டை இயக்கலாம் அல்லது கோப்புகளைத் திறக்கலாம். இதைத் திறக்க வேண்டாம்.</string>
    <string name="notice_dialer_code">இது சாதாரண எண் அல்ல, ஃபோன் சேவைக் குறியீடு. இத்தகைய குறியீடுகள் உங்கள் அழைப்புகளைத் திருப்பிவிடலாம், அமைப்புகளை மாற்றலாம் அல்லது கட்டணம் ஏற்படுத்தலாம். உங்கள் சேவை வழங்குநர் சொன்னால் மட்டுமே டயல் செய்யுங்கள்.</string>
    <string name="notice_premium_number">இது கூடுதல் கட்டண எண் போலத் தெரிகிறது. இதை அழைத்தால் நிமிடத்துக்கு அதிகக் கட்டணம் ஆகலாம்.</string>
    <string name="notice_local_only">இது உங்கள் ஃபோனிலேயே படிக்கப்பட்டது, எங்கும் அனுப்பப்படவில்லை.</string>

