    <!-- Typed cards: notices -->
    <string name="notice_payment">Đây là yêu cầu thanh toán. Hãy kiểm tra tên, tài khoản và số tiền trước khi trả. Thanh toán rất khó hoàn lại.</string>
    <string name="notice_paylink">Đây là yêu cầu thanh toán. Hãy kiểm tra tên và số tiền trong ứng dụng thanh toán trước khi xác nhận. Thanh toán rất khó hoàn lại.</string>
    <string name="notice_epc_instruction">Để thanh toán, hãy mở ứng dụng ngân hàng và quét mã QR này bằng ứng dụng đó.</string>
    <string name="notice_crypto">Thanh toán bằng tiền mã hóa không thể hoàn lại.</string>
    <string name="notice_invalid_iban">Số tài khoản không phải là IBAN hợp lệ.</string>
    <string name="notice_otp">Đây là khóa bí mật đăng nhập. Chỉ quét nó vào ứng dụng xác thực của chính bạn, và không bao giờ chia sẻ.</string>
    <string name="notice_wifi_open">Mạng này không có mật khẩu. Người ở gần có thể xem dữ liệu bạn gửi và nhận.</string>
    <string name="notice_sms_short_code">Tin nhắn đến đầu số ngắn có thể tốn tiền.</string>
    <string name="notice_app_link">Link này mở một ứng dụng khác. Chỉ tiếp tục nếu bạn đã biết trước điều đó.</string>
    <string name="notice_login_code">Mã này đăng nhập một thiết bị khác vào tài khoản của bạn. Chỉ quét nó từ bên trong ứng dụng đó, trên màn hình do chính bạn mở. Nếu ai đó gửi mã này cho bạn, đó là lừa đảo.</string>
    <string name="notice_chat_link">Link này mở cuộc trò chuyện với người bạn có thể không quen. Kẻ lừa đảo dùng link trò chuyện để kéo cuộc nói chuyện ra khỏi trang web bạn tin tưởng.</string>
    <string name="notice_otp_export">Mã này chứa khóa bí mật của mọi tài khoản trong một ứng dụng xác thực. Ai quét được mã này đều có thể tạo mã đăng nhập của bạn. Chỉ quét bằng điện thoại mới của chính bạn, và không bao giờ chia sẻ.</string>
    <string name="notice_esim_instruction">Để cài đặt, hãy mở phần cài đặt mạng di động trên điện thoại và thêm eSIM.</string>
    <string name="notice_esim">Mã này cài một gói di động (eSIM) lên điện thoại của bạn. Chỉ tiếp tục nếu nó đến từ nhà mạng của chính bạn.</string>
    <string name="notice_device_setup">Đây là mã cài đặt cho thiết bị nhà thông minh. Ai quét được mã này đều có thể thêm thiết bị vào nhà của họ. Chỉ quét bằng ứng dụng nhà thông minh của bạn, cho thiết bị bạn sở hữu.</string>
    <string name="notice_health_cert">Đây là giấy chứng nhận y tế. Nó chứa tên, ngày sinh và thông tin y tế. Mã được đọc trên điện thoại của bạn và không được gửi đi đâu. Đừng chia sẻ nó.</string>
    <string name="notice_unsafe_link">Đây không phải là địa chỉ web. Loại link này có thể chạy mã hoặc mở tệp trên điện thoại của bạn. Đừng mở nó.</string>
    <string name="notice_dialer_code">Đây là mã dịch vụ điện thoại, không phải số thường. Các mã như vậy có thể chuyển tiếp cuộc gọi, thay đổi cài đặt hoặc tốn tiền. Chỉ gọi nếu nhà mạng của bạn yêu cầu.</string>
    <string name="notice_premium_number">Đây có vẻ là số dịch vụ giá cao. Gọi đến số này có thể tốn nhiều tiền mỗi phút.</string>
    <string name="notice_local_only">Nội dung này được đọc trên điện thoại của bạn và không được gửi đi đâu.</string>

