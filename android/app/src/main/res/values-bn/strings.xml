    <!-- Typed cards: notices -->
    <string name="notice_payment">এটি একটি পেমেন্টের অনুরোধ। পেমেন্ট করার আগে নাম, অ্যাকাউন্ট ও পরিমাণ মিলিয়ে নিন। পেমেন্ট ফেরানো কঠিন।</string>
    <string name="notice_paylink">এটি একটি পেমেন্টের অনুরোধ। নিশ্চিত করার আগে আপনার পেমেন্ট অ্যাপে নাম ও পরিমাণ মিলিয়ে নিন। পেমেন্ট ফেরানো কঠিন।</string>
    <string name="notice_epc_instruction">পেমেন্ট করতে আপনার ব্যাংকিং অ্যাপ খুলে সেটি দিয়ে এই QR কোড স্ক্যান করুন।</string>
    <string name="notice_crypto">ক্রিপ্টো পেমেন্ট ফেরানো যায় না।</string>
    <string name="notice_invalid_iban">অ্যাকাউন্ট নম্বরটি সঠিক IBAN নয়।</string>
    <string name="notice_otp">এটি একটি সাইন-ইন সিক্রেট। শুধু আপনার নিজের অথেন্টিকেটর অ্যাপে এটি স্ক্যান করুন, আর কখনো কাউকে দেবেন না।</string>
    <string name="notice_wifi_open">এই নেটওয়ার্কের কোনো পাসওয়ার্ড নেই। আশেপাশের যে কেউ আপনার ডেটা আদান-প্রদান দেখতে পারে।</string>
    <string name="notice_sms_short_code">ছোট নম্বরে মেসেজ পাঠাতে টাকা লাগতে পারে।</string>
    <string name="notice_app_link">এটি অন্য একটি অ্যাপ খোলে। আপনি এটি আশা করে থাকলেই এগিয়ে যান।</string>
    <string name="notice_login_code">এই কোড অন্য একটি ডিভাইসকে আপনার অ্যাকাউন্টে সাইন ইন করায়। শুধু সেই অ্যাপের ভেতর থেকে, নিজে খোলা কোনো স্ক্রিনে এটি স্ক্যান করুন। কেউ আপনাকে এটি পাঠিয়ে থাকলে, এটি প্রতারণা।</string>
    <string name="notice_chat_link">এটি এমন কারও সাথে চ্যাট শুরু করে যাকে আপনি হয়তো চেনেন না। প্রতারকেরা বিশ্বস্ত সাইট থেকে কথোপকথন সরিয়ে নিতে চ্যাট লিংক ব্যবহার করে।</string>
    <string name="notice_otp_export">এই কোডে একটি অথেন্টিকেটর অ্যাপের প্রতিটি অ্যাকাউন্টের সিক্রেট থাকে। যে এটি স্ক্যান করবে, সে আপনার সাইন-ইন কোড তৈরি করতে পারবে। শুধু আপনার নিজের নতুন ফোন দিয়ে এটি স্ক্যান করুন, আর কখনো কাউকে দেবেন না।</string>
    <string name="notice_esim_instruction">ইনস্টল করতে আপনার ফোনের মোবাইল নেটওয়ার্ক সেটিংস খুলে একটি eSIM যোগ করুন।</string>
    <string name="notice_esim">এটি আপনার ফোনে একটি মোবাইল প্ল্যান (eSIM) ইনস্টল করে। এটি আপনার নিজের মোবাইল অপারেটরের কাছ থেকে এলেই এগিয়ে যান।</string>
    <string name="notice_device_setup">এটি একটি স্মার্ট-হোম ডিভাইসের সেটআপ কোড। যে এটি স্ক্যান করবে, সে ডিভাইসটি নিজের বাড়িতে যোগ করতে পারবে। শুধু আপনার স্মার্ট-হোম অ্যাপ দিয়ে, নিজের ডিভাইসের জন্য এটি স্ক্যান করুন।</string>
    <string name="notice_health_cert">এটি একটি স্বাস্থ্য সনদ। এতে একটি নাম, জন্মতারিখ ও চিকিৎসা-সংক্রান্ত তথ্য থাকে। এটি আপনার ফোনেই পড়া হয়েছে এবং কোথাও পাঠানো হয়নি। এটি কাউকে দেবেন না।</string>
    <string name="notice_unsafe_link">এটি কোনো ওয়েব ঠিকানা নয়। এ ধরনের লিংক আপনার ফোনে কোড চালাতে বা ফাইল খুলতে পারে। এটি খুলবেন না।</string>
    <string name="notice_dialer_code">এটি একটি ফোন সার্ভিস কোড, সাধারণ নম্বর নয়। এ ধরনের কোড আপনার কল অন্য নম্বরে পাঠাতে, সেটিংস বদলাতে বা টাকা কাটতে পারে। আপনার অপারেটর বলে থাকলেই এটি ডায়াল করুন।</string>
    <string name="notice_premium_number">এটি একটি প্রিমিয়াম-রেট নম্বর বলে মনে হচ্ছে। এতে কল করলে প্রতি মিনিটে অনেক টাকা লাগতে পারে।</string>
