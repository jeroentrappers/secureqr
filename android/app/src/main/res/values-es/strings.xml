    <!-- Typed cards: notices -->
    <string name="notice_payment">Esto es una solicitud de pago. Revisa el nombre, la cuenta y el importe antes de pagar. Los pagos son difíciles de deshacer.</string>
    <string name="notice_paylink">Esto es una solicitud de pago. Revisa el nombre y el importe en tu app de pago antes de confirmar. Los pagos son difíciles de deshacer.</string>
    <string name="notice_epc_instruction">Para pagar, abre la app de tu banco y escanea este código QR con ella.</string>
    <string name="notice_crypto">Los pagos con criptomonedas no se pueden revertir.</string>
    <string name="notice_invalid_iban">El número de cuenta no es un IBAN válido.</string>
    <string name="notice_otp">Esto es un secreto de inicio de sesión. Escanéalo solo en tu propia app de autenticación y no lo compartas nunca.</string>
    <string name="notice_wifi_open">Esta red no tiene contraseña. Cualquiera que esté cerca puede ver tu tráfico.</string>
    <string name="notice_sms_short_code">Los mensajes a números cortos pueden costar dinero.</string>
    <string name="notice_app_link">Esto abre otra app. Continúa solo si lo esperabas.</string>
    <string name="notice_login_code">Este código inicia sesión en tu cuenta desde otro dispositivo. Escanéalo solo desde dentro de esa app, en una pantalla que hayas abierto tú. Si alguien te lo ha enviado, es una estafa.</string>
    <string name="notice_chat_link">Esto inicia un chat con alguien que quizá no conoces. Los estafadores usan enlaces de chat para llevar la conversación fuera de un sitio de confianza.</string>
    <string name="notice_otp_export">Este código contiene los secretos de todas las cuentas de una app de autenticación. Quien lo escanee podrá generar tus códigos de inicio de sesión. Escanéalo solo con tu propio teléfono nuevo y no lo compartas nunca.</string>
    <string name="notice_esim_instruction">Para instalarlo, abre los ajustes de red móvil de tu teléfono y añade una eSIM.</string>
    <string name="notice_esim">Esto instala un plan móvil (eSIM) en tu teléfono. Continúa solo si viene de tu propio operador.</string>
    <string name="notice_device_setup">Esto es un código de configuración de un dispositivo de hogar inteligente. Quien lo escanee puede añadir el dispositivo a su propia casa. Escanéalo solo con tu app de hogar inteligente, para un dispositivo que sea tuyo.</string>
    <string name="notice_health_cert">Esto es un certificado sanitario. Contiene un nombre, una fecha de nacimiento y datos médicos. Se ha leído en tu teléfono y no se ha enviado a ninguna parte. No lo compartas.</string>
    <string name="notice_unsafe_link">Esto no es una dirección web. Los enlaces de este tipo pueden ejecutar código o abrir archivos en tu teléfono. No lo abras.</string>
    <string name="notice_dialer_code">Esto es un código de servicio telefónico, no un número normal. Estos códigos pueden desviar tus llamadas, cambiar ajustes o costar dinero. Márcalo solo si tu operador te lo ha indicado.</string>
    <string name="notice_premium_number">Parece un número de tarificación especial. Llamar puede costar mucho por minuto.</string>
    <string name="notice_local_only">Se ha leído en tu teléfono y no se ha enviado a ninguna parte.</string>

