    <!-- Typed cards: notices -->
    <string name="notice_payment">यह भुगतान का अनुरोध है। भुगतान से पहले नाम, खाता और राशि जाँच लें। भुगतान वापस लेना मुश्किल होता है।</string>
    <string name="notice_paylink">यह भुगतान का अनुरोध है। पुष्टि करने से पहले अपने भुगतान ऐप में नाम और राशि जाँच लें। भुगतान वापस लेना मुश्किल होता है।</string>
    <string name="notice_epc_instruction">भुगतान के लिए अपना बैंकिंग ऐप खोलें और उससे यह QR कोड स्कैन करें।</string>
    <string name="notice_crypto">क्रिप्टो भुगतान वापस नहीं लिए जा सकते।</string>
    <string name="notice_invalid_iban">खाता नंबर एक मान्य IBAN नहीं है।</string>
    <string name="notice_otp">यह एक साइन-इन सीक्रेट है। इसे सिर्फ़ अपने ऑथेंटिकेटर ऐप में स्कैन करें, और कभी किसी से शेयर न करें।</string>
    <string name="notice_wifi_open">इस नेटवर्क का कोई पासवर्ड नहीं है। आस-पास का कोई भी आपका ट्रैफ़िक देख सकता है।</string>
    <string name="notice_sms_short_code">छोटे नंबरों पर संदेश भेजने में पैसे लग सकते हैं।</string>
    <string name="notice_app_link">यह कोई दूसरा ऐप खोलता है। आगे तभी बढ़ें जब आपको इसकी उम्मीद थी।</string>
    <string name="notice_login_code">यह कोड किसी दूसरे डिवाइस को आपके अकाउंट में साइन इन कराता है। इसे सिर्फ़ उसी ऐप के अंदर से, ख़ुद खोली गई स्क्रीन पर स्कैन करें। अगर किसी ने यह आपको भेजा है, तो यह धोखाधड़ी है।</string>
    <string name="notice_chat_link">इससे किसी ऐसे व्यक्ति के साथ चैट शुरू होती है जिसे आप शायद नहीं जानते। धोखेबाज़ चैट लिंक का इस्तेमाल बातचीत को किसी भरोसेमंद साइट से दूर ले जाने के लिए करते हैं।</string>
    <string name="notice_otp_export">इस कोड में किसी ऑथेंटिकेटर ऐप के हर अकाउंट के सीक्रेट होते हैं। जो भी इसे स्कैन करेगा, वह आपके साइन-इन कोड बना सकता है। इसे सिर्फ़ अपने नए फ़ोन से स्कैन करें, और कभी किसी से शेयर न करें।</string>
    <string name="notice_esim_instruction">इसे इंस्टॉल करने के लिए अपने फ़ोन की मोबाइल नेटवर्क सेटिंग खोलें और एक eSIM जोड़ें।</string>
    <string name="notice_esim">यह आपके फ़ोन पर एक मोबाइल प्लान (eSIM) इंस्टॉल करता है। आगे तभी बढ़ें जब यह आपकी अपनी मोबाइल कंपनी से आया हो।</string>
    <string name="notice_device_setup">यह किसी स्मार्ट-होम डिवाइस का सेटअप कोड है। जो भी इसे स्कैन करेगा, वह डिवाइस को अपने घर में जोड़ सकता है। इसे सिर्फ़ अपने स्मार्ट-होम ऐप से, अपने ही डिवाइस के लिए स्कैन करें।</string>
    <string name="notice_health_cert">यह एक स्वास्थ्य प्रमाणपत्र है। इसमें नाम, जन्म तिथि और चिकित्सा जानकारी होती है। इसे आपके फ़ोन पर पढ़ा गया और कहीं नहीं भेजा गया। इसे शेयर न करें।</string>
    <string name="notice_unsafe_link">यह कोई वेब पता नहीं है। इस तरह के लिंक आपके फ़ोन पर कोड चला सकते हैं या फ़ाइलें खोल सकते हैं। इसे न खोलें।</string>
    <string name="notice_dialer_code">यह फ़ोन का सर्विस कोड है, सामान्य नंबर नहीं। ऐसे कोड आपकी कॉल फ़ॉरवर्ड कर सकते हैं, सेटिंग बदल सकते हैं या पैसे ख़र्च करा सकते हैं। इसे तभी डायल करें जब आपकी मोबाइल कंपनी ने ऐसा कहा हो।</string>
    <string name="notice_premium_number">यह प्रीमियम-रेट नंबर लगता है। इस पर कॉल करने में हर मिनट बहुत पैसे लग सकते हैं।</string>
    <string name="notice_local_only">इसे आपके फ़ोन पर पढ़ा गया और कहीं नहीं भेजा गया।</string>

