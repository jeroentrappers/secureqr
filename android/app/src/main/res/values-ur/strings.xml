    <!-- Typed cards: notices -->
    <string name="notice_payment">یہ ادائیگی کی درخواست ہے۔ ادائیگی سے پہلے نام، اکاؤنٹ اور رقم چیک کریں۔ ادائیگی واپس لینا مشکل ہوتا ہے۔</string>
    <string name="notice_paylink">یہ ادائیگی کی درخواست ہے۔ تصدیق سے پہلے اپنی ادائیگی کی ایپ میں نام اور رقم چیک کریں۔ ادائیگی واپس لینا مشکل ہوتا ہے۔</string>
    <string name="notice_epc_instruction">ادائیگی کے لیے اپنی بینکنگ ایپ کھولیں اور اس سے یہ QR کوڈ اسکین کریں۔</string>
    <string name="notice_crypto">کرپٹو ادائیگیاں واپس نہیں ہو سکتیں۔</string>
    <string name="notice_invalid_iban">اکاؤنٹ نمبر درست IBAN نہیں ہے۔</string>
    <string name="notice_otp">یہ سائن اِن کا خفیہ کوڈ ہے۔ اسے صرف اپنی آتھینٹیکیٹر ایپ میں اسکین کریں، اور کبھی کسی کو نہ دیں۔</string>
    <string name="notice_wifi_open">اس نیٹ ورک کا کوئی پاس ورڈ نہیں۔ قریب موجود کوئی بھی آپ کا ڈیٹا دیکھ سکتا ہے۔</string>
    <string name="notice_sms_short_code">مختصر نمبروں پر میسج بھیجنے کے پیسے لگ سکتے ہیں۔</string>
    <string name="notice_app_link">یہ کوئی دوسری ایپ کھولتا ہے۔ صرف تب آگے بڑھیں جب آپ کو اس کی توقع ہو۔</string>
    <string name="notice_login_code">یہ کوڈ کسی دوسری ڈیوائس کو آپ کے اکاؤنٹ میں سائن اِن کر دیتا ہے۔ اسے صرف اسی ایپ کے اندر سے، اپنی کھولی ہوئی اسکرین پر اسکین کریں۔ اگر کسی نے یہ آپ کو بھیجا ہے تو یہ فراڈ ہے۔</string>
    <string name="notice_chat_link">یہ کسی ایسے شخص سے چیٹ شروع کرتا ہے جسے شاید آپ نہیں جانتے۔ فراڈ کرنے والے چیٹ لنک کے ذریعے بات چیت کو کسی بھروسے والی سائٹ سے دور لے جاتے ہیں۔</string>
    <string name="notice_otp_export">اس کوڈ میں آتھینٹیکیٹر ایپ کے ہر اکاؤنٹ کے خفیہ کوڈ موجود ہیں۔ جو بھی اسے اسکین کرے، وہ آپ کے سائن اِن کوڈ بنا سکتا ہے۔ اسے صرف اپنے نئے فون سے اسکین کریں، اور کبھی کسی کو نہ دیں۔</string>
    <string name="notice_esim_instruction">انسٹال کرنے کے لیے اپنے فون کی موبائل نیٹ ورک سیٹنگز کھولیں اور eSIM شامل کریں۔</string>
    <string name="notice_esim">یہ آپ کے فون پر ایک موبائل پلان (eSIM) انسٹال کرتا ہے۔ صرف تب آگے بڑھیں جب یہ آپ کی اپنی موبائل کمپنی کی طرف سے ہو۔</string>
    <string name="notice_device_setup">یہ اسمارٹ ہوم ڈیوائس کا سیٹ اپ کوڈ ہے۔ جو بھی اسے اسکین کرے، وہ ڈیوائس کو اپنے گھر میں شامل کر سکتا ہے۔ اسے صرف اپنی اسمارٹ ہوم ایپ سے، اپنی ہی ڈیوائس کے لیے اسکین کریں۔</string>
    <string name="notice_health_cert">یہ صحت کا سرٹیفکیٹ ہے۔ اس میں نام، تاریخ پیدائش اور طبی تفصیلات ہیں۔ اسے آپ کے فون پر پڑھا گیا اور کہیں نہیں بھیجا گیا۔ اسے کسی کو نہ دیں۔</string>
    <string name="notice_unsafe_link">یہ ویب ایڈریس نہیں ہے۔ اس قسم کے لنک آپ کے فون پر کوڈ چلا سکتے ہیں یا فائلیں کھول سکتے ہیں۔ اسے نہ کھولیں۔</string>
    <string name="notice_dialer_code">یہ فون سروس کوڈ ہے، عام نمبر نہیں۔ ایسے کوڈ آپ کی کالیں آگے بھیج سکتے ہیں، سیٹنگز بدل سکتے ہیں یا پیسے کاٹ سکتے ہیں۔ اسے صرف تب ڈائل کریں جب آپ کی موبائل کمپنی نے کہا ہو۔</string>
    <string name="notice_premium_number">یہ پریمیم ریٹ نمبر لگتا ہے۔ اس پر کال کرنے سے فی منٹ کافی پیسے لگ سکتے ہیں۔</string>
    <string name="notice_local_only">اسے آپ کے فون پر پڑھا گیا اور کہیں نہیں بھیجا گیا۔</string>

