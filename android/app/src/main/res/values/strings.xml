    <!-- Typed cards: notices -->
    <string name="notice_payment">This is a payment request. Check the name, account and amount before you pay. Payments are hard to undo.</string>
    <string name="notice_paylink">This is a payment request. Check the name and amount in your payment app before you confirm. Payments are hard to undo.</string>
    <string name="notice_epc_instruction">To pay, open your banking app and scan this QR code with it.</string>
    <string name="notice_crypto">Crypto payments cannot be reversed.</string>
    <string name="notice_invalid_iban">The account number is not a valid IBAN.</string>
    <string name="notice_otp">This is a sign-in secret. Only scan it into your own authenticator app, and never share it.</string>
    <string name="notice_wifi_open">This network has no password. Anyone nearby can see your traffic.</string>
    <string name="notice_sms_short_code">Messages to short numbers can cost money.</string>
    <string name="notice_app_link">This opens another app. Only continue if you expected that.</string>
    <string name="notice_login_code">This code signs another device in to your account. Only scan it from inside that app, on a screen you opened yourself. If someone sent it to you, it is a scam.</string>
    <string name="notice_chat_link">This starts a chat with someone you may not know. Scammers use chat links to move a conversation away from a site you trust.</string>
    <string name="notice_otp_export">This code holds the secrets of every account in an authenticator app. Whoever scans it can make your sign-in codes. Only scan it with your own new phone, and never share it.</string>
    <string name="notice_esim_instruction">To install it, open your phone\'s mobile network settings and add an eSIM.</string>
    <string name="notice_esim">This installs a mobile plan (eSIM) on your phone. Only continue if it comes from your own mobile provider.</string>
    <string name="notice_device_setup">This is a setup code for a smart-home device. Whoever scans it can add the device to their own home. Only scan it with your smart-home app, for a device you own.</string>
    <string name="notice_health_cert">This is a health certificate. It holds a name, a date of birth and medical details. It was read on your phone and not sent anywhere. Do not share it.</string>
    <string name="notice_unsafe_link">This is not a web address. Links of this kind can run code or open files on your phone. Do not open it.</string>
    <string name="notice_dialer_code">This is a phone service code, not a normal number. Such codes can forward your calls, change settings or cost money. Only dial it if your provider told you to.</string>
    <string name="notice_premium_number">This looks like a premium-rate number. Calling it can cost a lot per minute.</string>
    <string name="notice_local_only">This was read on your phone and not sent anywhere.</string>

