# Connects fastlane to Google Play Console.
#
# `package_name` matches `applicationId` in app/build.gradle.kts.
# `json_key_file` is the Play service-account key ("Release manager" on the
# Play Console). It MUST stay out of git: point SUPPLY_JSON_KEY_FILE at it,
# or keep it (or a symlink to it) as android/play-service-account.json.

json_key_file(ENV["SUPPLY_JSON_KEY_FILE"] || "../play-service-account.json")
package_name("be.appmire.secureqr")
